    "licenseInformation": {
      "type": "free",
      "license": "MIT"
    },
    "platform": "Javascript/Node.js",
    "icon": "bacnet-client.png",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/Petzi2712/ioBroker.bacnet-client/main/admin/bacnet-client.png",
    "readme": "https://github.com/Petzi2712/ioBroker.bacnet-client/blob/main/README.md",
    "loglevel": "info",
    "tier": 3,
    "mode": "daemon",
    "type": "protocols",
    "compact": true,
    "connectionType": "local",
    "dataSource": "poll",
    "messagebox": true,
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=6.0.11"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=7.6.20"
      }
    ]
  },
  "native": {
    "bindAddress": "0.0.0.0",
    "subnetCidr": "",
    "broadcastAddress": "255.255.255.255",
    "port": 47808,
    "discoveryTimeoutMs": 5000,
    "lowLimit": null,
    "highLimit": null,
    "additionalTargets": [],
    "apduTimeoutMs": 3000,
    "retries": 2,
    "requestConcurrency": 4,
    "perDeviceConcurrency": 2,
    "pollIntervalMs": 30000,
    "pollingEnabled": true,
    "covEnabled": false,
    "writeEnabled": false,
    "writePriority": 16,
    "writeAllowlist": [],
    "staleScansBeforeDelete": 3,
    "autoImportAll": false
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "BACnet socket ready",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.socketReady",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "BACnet socket ready",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.discoveryRunning",
      "type": "state",
      "common": {
        "role": "indicator.working",
        "name": "Discovery running",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.discoveryProgress",
      "type": "state",
      "common": {
        "role": "value",
        "name": "Discovery progress",
        "type": "number",
        "unit": "%",
        "min": 0,
        "max": 100,
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.lastDiscovery",
      "type": "state",
      "common": {
        "role": "date",
        "name": "Last discovery",
        "type": "number",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.discoveredDevices",
      "type": "state",
      "common": {
        "role": "value",
        "name": "Discovered devices",
        "type": "number",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.importedDevices",
      "type": "state",
      "common": {
        "role": "value",
        "name": "Imported devices",
        "type": "number",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.importedObjects",
      "type": "state",
      "common": {
        "role": "value",
        "name": "Imported objects",
        "type": "number",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.lastError",
      "type": "state",
      "common": {
        "role": "text",
        "name": "Last error",
        "type": "string",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    }
  ]
